[Unit]
Description=Kuvoz Incubator Web Server
After=network.target
Wants=network.target

[Service]
Type=simple
User=vet
Group=vet
WorkingDirectory=/home/vet/kuvoz
Environment=PYTHONPATH=/home/vet/kuvoz:/home/vet/kuvoz/lib
ExecStart=/usr/bin/python3 /home/vet/kuvoz/web_server.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# GPIO access
SupplementaryGroups=gpio i2c spi

# Environment variables
Environment=FLASK_ENV=production
Environment=PYTHONUNBUFFERED=1
Environment=EVENTLET_NO_GREENDNS=yes
Environment=KUVOZ_SOCKETIO_ASYNC_MODE=eventlet
Environment=LANG=tr_TR.UTF-8
Environment=LANGUAGE=tr_TR:tr
Environment=LC_CTYPE=tr_TR.UTF-8

[Install]
WantedBy=multi-user.target
